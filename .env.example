# Portal authentication credentials (REQUIRED — portal will not start without these)
AUTH_USERNAME=
AUTH_PASSWORD=

# MongoDB credentials (defaults provided for local dev)
MONGO_ROOT_USERNAME=dmfco
MONGO_ROOT_PASSWORD=dmfco-dev-password

# Cookie security (set to true in production with HTTPS)
# COOKIE_SECURE=false

# CORS allowed origins (comma-separated, defaults to localhost for dev)
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# Anthropic API key (used by knowledge-api for entity extraction,
# and by portal-api for eval judge)
# ANTHROPIC_API_KEY=

# LanceDB data path (defaults to ./data/knowledge.lance in local dev)
# LANCE_DB_PATH=./data/knowledge.lance

# Langfuse observability (cost + performance tracing).
# When LANGFUSE_ENABLED is not "true", no traces are exported and the app
# logs to stdout as before. All traces are tagged with the app name "teun".
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Embeddings (RAG) — Azure OpenAI is the PRIMARY provider.
# text-embedding-3-large produces 3072-dim vectors for chunks and queries.
# Real key goes in .env / App settings only — NEVER commit it.
AZURE_OPENAI_ENDPOINT=https://dmfco-ai-tools-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional fallback: plain OpenAI (used only when the AZURE_OPENAI_* vars are unset)
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-large
